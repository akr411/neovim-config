{
    "Function": {
        "prefix": "fn",
        "body": ["fn ${1:name}(${2:args}) -> ${3:ReturnType} {", "\t${0}", "}"],
        "description": "Function definition"
    },
    "Async function": {
        "prefix": "afn",
        "body": ["async fn ${1:name}(${2:args}) -> ${3:ReturnType} {", "\t${0}", "}"],
        "description": "Async function definition"
    },
    "Struct": {
        "prefix": "struct",
        "body": ["struct ${1:Name} {", "\t${2:field}: ${3:Type},", "}"],
        "description": "Struct definition"
    },
    "Enum": {
        "prefix": "enum",
        "body": ["enum ${1:Name} {", "\t${2:Variant},", "}"],
        "description": "Enum definition"
    },
    "Impl block": {
        "prefix": "impl",
        "body": ["impl ${1:Type} {", "\t${0}", "}"],
        "description": "impl block"
    },
    "Impl trait": {
        "prefix": "implt",
        "body": ["impl ${1:Trait} for ${2:Type} {", "\t${0}", "}"],
        "description": "impl Trait for Type"
    },
    "Match": {
        "prefix": "match",
        "body": ["match ${1:expr} {", "\t${2:pattern} => ${3:result},", "\t_ => ${0},", "}"],
        "description": "match expression"
    },
    "Result Ok/Err match": {
        "prefix": "mres",
        "body": ["match ${1:expr} {", "\tOk(${2:val}) => ${3},", "\tErr(${4:e}) => ${0},", "}"],
        "description": "match on Result"
    },
    "Option Some/None match": {
        "prefix": "mopt",
        "body": ["match ${1:expr} {", "\tSome(${2:val}) => ${3},", "\tNone => ${0},", "}"],
        "description": "match on Option"
    },
    "if let Some": {
        "prefix": "iflet",
        "body": ["if let Some(${1:val}) = ${2:expr} {", "\t${0}", "}"],
        "description": "if let Some pattern"
    },
    "unwrap_or_else": {
        "prefix": "uoe",
        "body": [".unwrap_or_else(|${1:e}| {", "\t${0}", "})"],
        "description": "unwrap_or_else closure"
    },
    "Test module": {
        "prefix": "testmod",
        "body": [
            "#[cfg(test)]",
            "mod tests {",
            "\tuse super::*;",
            "",
            "\t#[test]",
            "\tfn ${1:test_name}() {",
            "\t\t${0}",
            "\t}",
            "}"
        ],
        "description": "Test module with first test"
    },
    "Test function": {
        "prefix": "test",
        "body": ["#[test]", "fn ${1:test_name}() {", "\t${0}", "}"],
        "description": "Single test function"
    },
    "Async test": {
        "prefix": "atest",
        "body": ["#[tokio::test]", "async fn ${1:test_name}() {", "\t${0}", "}"],
        "description": "Async test with tokio"
    },
    "Derive": {
        "prefix": "derive",
        "body": ["#[derive(${1:Debug, Clone})]"],
        "description": "#[derive(...)]"
    },
    "Vec macro": {
        "prefix": "vec",
        "body": ["vec![${0}]"],
        "description": "vec! macro"
    },
    "println": {
        "prefix": "pl",
        "body": ["println!(\"${1}\", ${0});"],
        "description": "println! macro"
    },
    "dbg": {
        "prefix": "dbg",
        "body": ["dbg!(&${0});"],
        "description": "dbg! macro"
    },
    "todo": {
        "prefix": "todo",
        "body": ["todo!(\"${0}\")"],
        "description": "todo! macro"
    },
    "use statement": {
        "prefix": "use",
        "body": ["use ${1:crate}::${0};"],
        "description": "use import"
    },
    "pub use": {
        "prefix": "puse",
        "body": ["pub use ${1:crate}::${0};"],
        "description": "pub use re-export"
    },
    "Closure": {
        "prefix": "cl",
        "body": ["|${1:args}| ${0}"],
        "description": "Closure expression"
    },
    "map closure": {
        "prefix": "map",
        "body": [".map(|${1:x}| ${0})"],
        "description": ".map(|x| ...)"
    },
    "filter closure": {
        "prefix": "filt",
        "body": [".filter(|${1:x}| ${0})"],
        "description": ".filter(|x| ...)"
    }
}
