{
    "Function component": {
        "prefix": "rfc",
        "body": [
            "export default function ${1:Component}() {",
            "\treturn (",
            "\t\t<div>${0}</div>",
            "\t);",
            "}"
        ],
        "description": "React function component"
    },
    "Function component with props": {
        "prefix": "rfcp",
        "body": [
            "interface ${1:Component}Props {",
            "\t${2:prop}: ${3:type};",
            "}",
            "",
            "export default function ${1:Component}({ ${2:prop} }: ${1:Component}Props) {",
            "\treturn (",
            "\t\t<div>${0}</div>",
            "\t);",
            "}"
        ],
        "description": "React function component with typed props"
    },
    "Named component": {
        "prefix": "rnc",
        "body": [
            "export function ${1:Component}() {",
            "\treturn (",
            "\t\t<div>${0}</div>",
            "\t);",
            "}"
        ],
        "description": "Named React component"
    },
    "useState": {
        "prefix": "ust",
        "body": ["const [${1:state}, set${1/(.*)/${1:/capitalize}/}] = useState<${2:Type}>(${0});"],
        "description": "useState hook"
    },
    "useEffect": {
        "prefix": "uef",
        "body": ["useEffect(() => {", "\t${0}", "}, [${1}]);"],
        "description": "useEffect hook"
    },
    "useEffect cleanup": {
        "prefix": "uefc",
        "body": ["useEffect(() => {", "\t${1}", "\treturn () => {", "\t\t${0}", "\t};", "}, [${2}]);"],
        "description": "useEffect with cleanup"
    },
    "useCallback": {
        "prefix": "ucb",
        "body": ["const ${1:fn} = useCallback((${2}) => {", "\t${0}", "}, [${3}]);"],
        "description": "useCallback hook"
    },
    "useMemo": {
        "prefix": "umo",
        "body": ["const ${1:value} = useMemo(() => ${0}, [${2}]);"],
        "description": "useMemo hook"
    },
    "useRef": {
        "prefix": "urf",
        "body": ["const ${1:ref} = useRef<${2:HTMLElement}>(${0:null});"],
        "description": "useRef hook"
    },
    "useContext": {
        "prefix": "uctx",
        "body": ["const ${1:value} = useContext(${0:Context});"],
        "description": "useContext hook"
    },
    "useReducer": {
        "prefix": "ured",
        "body": ["const [${1:state}, dispatch] = useReducer(${2:reducer}, ${0:initialState});"],
        "description": "useReducer hook"
    },
    "Custom hook": {
        "prefix": "hook",
        "body": ["export function use${1:Name}() {", "\t${0}", "}"],
        "description": "Custom hook"
    },
    "Context": {
        "prefix": "ctx",
        "body": [
            "const ${1:Name}Context = createContext<${2:Type} | undefined>(undefined);",
            "",
            "export function ${1:Name}Provider({ children }: { children: React.ReactNode }) {",
            "\t${0}",
            "\treturn <${1:Name}Context.Provider value={${3:value}}>{children}</${1:Name}Context.Provider>;",
            "}"
        ],
        "description": "Context + provider"
    },
    "Fragment": {
        "prefix": "frag",
        "body": ["<>", "\t${0}", "</>"],
        "description": "React fragment"
    },
    "Conditional render": {
        "prefix": "cond",
        "body": ["{${1:condition} && (", "\t${0}", ")}"],
        "description": "Conditional rendering"
    },
    "Ternary render": {
        "prefix": "tern",
        "body": ["{${1:condition} ? (", "\t${2}", ") : (", "\t${0}", ")}"],
        "description": "Ternary rendering"
    },
    "List render": {
        "prefix": "lmap",
        "body": ["{${1:items}.map((${2:item}) => (", "\t<${3:div} key={${2:item}.${4:id}}>${0}</${3:div}>", "))}"],
        "description": "Render list with map"
    },
    "Props type": {
        "prefix": "props",
        "body": ["interface ${1:Component}Props {", "\t${0}", "}"],
        "description": "Props interface"
    },
    "Event handler": {
        "prefix": "evh",
        "body": ["const handle${1:Event} = (e: React.${2:MouseEvent}<HTMLButtonElement>) => {", "\t${0}", "};"],
        "description": "Event handler"
    },
    "onChange handler": {
        "prefix": "onch",
        "body": ["const handle${1:Change} = (e: React.ChangeEvent<HTMLInputElement>) => {", "\tset${2:State}(e.target.value);", "};"],
        "description": "Input onChange handler"
    },
    "forwardRef": {
        "prefix": "fref",
        "body": [
            "const ${1:Component} = forwardRef<${2:HTMLElement}, ${1:Component}Props>(",
            "\tfunction ${1:Component}({ ${3} }, ref) {",
            "\t\treturn <${4:div} ref={ref}>${0}</${4:div}>;",
            "\t}",
            ");"
        ],
        "description": "forwardRef component"
    },
    "memo": {
        "prefix": "memo",
        "body": ["const ${1:Component} = memo(function ${1:Component}(${2:props}) {", "\treturn <div>${0}</div>;", "});"],
        "description": "React.memo component"
    }
}
